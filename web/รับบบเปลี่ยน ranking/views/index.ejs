<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>vMix Sheet Manager</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        bg: '#0a0c10',
                        surface: '#111318',
                        surface2: '#1a1d24',
                        primary: '#3182ce',
                        success: '#38a169',
                        danger: '#e53e3e',
                        warning: '#d69e2e'
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0a0c10;
            color: #e2e8f0;
            overflow: hidden; /* App like feel */
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #0a0c10; }
        ::-webkit-scrollbar-thumb { background: #2d3748; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #4a5568; }
        
        .tab-btn.active {
            background-color: #1a1d24;
            border-left: 4px solid #3182ce;
            color: #fff;
        }
        .tab-btn {
            border-left: 4px solid transparent;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>

<body class="h-screen flex flex-col">

    <!-- Global Top Bar -->
    <div class="h-16 bg-surface border-b border-white/10 flex items-center justify-between px-6 shrink-0 z-20">
        <div class="flex items-center gap-4">
            <h1 class="text-2xl font-black text-yellow-500 tracking-tighter">VMIX SHEET MANAGER</h1>
            <div class="hidden md:flex items-center gap-2 text-xs font-bold bg-bg px-3 py-1.5 rounded-full border border-white/5">
                <div class="w-2.5 h-2.5 rounded-full bg-success shadow-[0_0_8px_rgba(56,161,105,0.8)]"></div>
                <span class="text-success uppercase tracking-wider">ONLINE</span>
            </div>
        </div>
        <button id="openSettingsBtn" class="text-sm font-bold bg-surface2 border border-white/10 hover:bg-white/10 px-4 py-2 rounded transition-colors text-gray-300">
            ⚙️ System Config
        </button>
    </div>

    <!-- Credentials Warning -->
    <div id="credentials-alert" class="hidden bg-warning/20 border-b border-warning/50 text-warning px-4 py-2 text-sm font-bold text-center">
        ⚠️ Warning: 'credentials.json' is missing. The system cannot authenticate with Google Sheets.
    </div>

    <!-- Main Layout -->
    <div class="flex flex-1 overflow-hidden relative">
        
        <!-- Sidebar Navigation -->
        <div class="w-64 bg-surface border-r border-white/10 h-full flex flex-col" id="sheetSelectGroup" style="display: none;">
            <div class="p-4 border-b border-white/10">
               <h2 class="text-xs uppercase text-gray-500 font-bold tracking-widest">Ranking Engine</h2> 
            </div>
            <nav class="flex flex-col py-2 gap-1 flex-1">
                <button class="tab-btn active flex items-center gap-3 w-full text-left px-4 py-3 text-sm font-bold text-gray-400 hover:bg-white/5 hover:text-white transition-colors" data-target="day-panel" id="day-tab">
                    📅 Day Ranking
                </button>
                <button class="tab-btn flex items-center gap-3 w-full text-left px-4 py-3 text-sm font-bold text-gray-400 hover:bg-white/5 hover:text-white transition-colors" data-target="week-panel" id="week-tab">
                    📆 Week Ranking
                </button>
                <button class="tab-btn flex items-center gap-3 w-full text-left px-4 py-3 text-sm font-bold text-gray-400 hover:bg-white/5 hover:text-white transition-colors" data-target="overall-panel" id="overall-tab">
                    🏆 Overall Ranking
                </button>
            </nav>
        </div>

        <!-- Main Content Area -->
        <div class="flex-1 bg-bg p-6 overflow-y-auto relative flex flex-col gap-6">

            <!-- Tab Panels (Controls) -->
            <div id="controls-container" class="max-w-4xl" style="display: none;">
                
                <!-- Day Panel -->
                <div id="day-panel" class="tab-content block bg-surface border border-white/10 p-6 rounded-xl shadow-lg">
                    <h3 class="text-lg font-bold text-blue-400 mb-4 border-b border-white/10 pb-2">Sync Day Data</h3>
                    <div class="flex flex-col md:flex-row gap-4">
                        <div class="flex-1">
                            <label class="text-xs uppercase text-gray-500 font-bold block mb-2">Select Target Sheet</label>
                            <select class="w-full bg-bg border border-white/10 rounded p-3 text-sm focus:border-primary outline-none transition-colors sheet-select" data-type="day" id="sheetSelectDay">
                                <option value="">-- Choose Sheet --</option>
                            </select>
                        </div>
                        <div class="flex items-end">
                            <button class="bg-success hover:bg-green-500 text-white font-bold py-3 px-8 rounded shadow-[0_0_10px_rgba(56,161,105,0.4)] transition-all active:scale-95 send-btn" data-type="day">
                                🚀 SEND TO VMIX
                            </button>
                        </div>
                    </div>
                    <div class="mt-3 text-xs font-bold text-center py-2 rounded status-alert hidden" id="statusDay"></div>
                </div>

                <!-- Week Panel -->
                <div id="week-panel" class="tab-content hidden bg-surface border border-white/10 p-6 rounded-xl shadow-lg">
                    <h3 class="text-lg font-bold text-blue-400 mb-4 border-b border-white/10 pb-2">Sync Week Data</h3>
                    <div class="flex flex-col md:flex-row gap-4">
                        <div class="flex-1">
                            <label class="text-xs uppercase text-gray-500 font-bold block mb-2">Select Target Sheet</label>
                            <select class="w-full bg-bg border border-white/10 rounded p-3 text-sm focus:border-primary outline-none transition-colors sheet-select" data-type="week" id="sheetSelectWeek">
                                <option value="">-- Choose Sheet --</option>
                            </select>
                        </div>
                        <div class="flex items-end">
                            <button class="bg-success hover:bg-green-500 text-white font-bold py-3 px-8 rounded shadow-[0_0_10px_rgba(56,161,105,0.4)] transition-all active:scale-95 send-btn" data-type="week">
                                🚀 SEND TO VMIX
                            </button>
                        </div>
                    </div>
                    <div class="mt-3 text-xs font-bold text-center py-2 rounded status-alert hidden" id="statusWeek"></div>
                </div>

                <!-- Overall Panel -->
                <div id="overall-panel" class="tab-content hidden bg-surface border border-white/10 p-6 rounded-xl shadow-lg">
                    <h3 class="text-lg font-bold text-blue-400 mb-4 border-b border-white/10 pb-2">Sync Overall Data</h3>
                    <div class="flex flex-col md:flex-row gap-4">
                        <div class="flex-1">
                            <label class="text-xs uppercase text-gray-500 font-bold block mb-2">Select Target Sheet</label>
                            <select class="w-full bg-bg border border-white/10 rounded p-3 text-sm focus:border-primary outline-none transition-colors sheet-select" data-type="overall" id="sheetSelectOverall">
                                <option value="">-- Choose Sheet --</option>
                            </select>
                        </div>
                        <div class="flex items-end">
                            <button class="bg-success hover:bg-green-500 text-white font-bold py-3 px-8 rounded shadow-[0_0_10px_rgba(56,161,105,0.4)] transition-all active:scale-95 send-btn" data-type="overall">
                                🚀 SEND TO VMIX
                            </button>
                        </div>
                    </div>
                    <div class="mt-3 text-xs font-bold text-center py-2 rounded status-alert hidden" id="statusOverall"></div>
                </div>

            </div>

            <!-- Preview Data Table -->
            <div id="noDataPlaceholder" class="h-full flex flex-col items-center justify-center text-gray-600">
                <div class="text-6xl mb-4">📊</div>
                <div class="text-lg font-bold">Select a sheet to preview data</div>
            </div>

            <div id="previewCard" class="hidden bg-surface rounded-xl border border-white/10 shadow-lg flex-1 flex flex-col min-h-0">
                <div class="p-4 border-b border-white/10 flex justify-between items-center bg-surface2 shrink-0 rounded-t-xl">
                    <h3 class="font-bold text-white text-sm">
                        Live Preview: <span id="previewType" class="text-primary uppercase tracking-widest ml-2 text-xs"></span>
                    </h3>
                    <button id="closePreviewBtn" class="text-xs bg-bg border border-white/10 hover:bg-danger/20 hover:text-danger hover:border-danger/50 text-gray-400 px-3 py-1.5 rounded font-bold transition-colors">
                        CLOSE
                    </button>
                </div>
                <div class="overflow-auto flex-1 p-0">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead class="bg-bg text-gray-500 text-[10px] tracking-widest uppercase sticky top-0 border-b border-white/10">
                            <tr id="tableHead"></tr>
                        </thead>
                        <tbody id="tableBody" class="divide-y divide-white/5"></tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

    <!-- Settings Modal Overlay -->
    <div id="settingsModal" class="fixed inset-0 bg-black/80 z-50 flex items-center justify-center hidden opacity-0 transition-opacity">
        <div class="bg-surface border border-white/10 rounded-xl shadow-2xl w-full max-w-md overflow-hidden transform scale-95 transition-transform" id="settingsModalContent">
            <div class="p-4 border-b border-white/10 flex justify-between items-center bg-surface2">
                <h2 class="font-bold text-white tracking-wide">⚙️ System Configuration</h2>
                <button id="closeSettingsBtn" class="text-gray-400 hover:text-white font-bold px-2 py-1">✕</button>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-xs uppercase text-gray-500 font-bold mb-2">Spreadsheet Presets</label>
                    <select id="configSelect" class="w-full bg-bg border border-white/10 rounded p-3 text-sm focus:border-primary outline-none transition-colors">
                        <option value="">-- Custom Spreadsheet --</option>
                        <% if (sheets && sheets.length> 0) { %>
                            <% sheets.forEach(function(sheet) { %>
                                <option value="<%= sheet.id %>"><%= sheet.name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div>
                    <label class="block text-xs uppercase text-gray-500 font-bold mb-2">Custom Spreadsheet ID</label>
                    <input type="text" id="spreadsheetId" placeholder="Enter ID here..." class="w-full bg-bg border border-white/10 rounded p-3 text-sm font-mono focus:border-primary outline-none transition-colors">
                </div>
                <button id="fetchSheetsBtn" class="w-full bg-primary hover:bg-blue-500 text-white font-bold py-3 rounded shadow-[0_0_10px_rgba(49,130,206,0.3)] transition-colors mt-2">
                    Apply & Sync Sheets
                </button>
            </div>
        </div>
    </div>

    <!-- Toast Notification Overlay -->
    <div id="toastContainer" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2"></div>

    <script src="/js/script.js"></script>
</body>

</html>